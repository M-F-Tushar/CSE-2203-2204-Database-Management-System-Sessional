    {
      "id": "cLxwgVY3h23a9e0bY33R7",
      "type": "text",
      "x": 221.5400619506836,
      "y": 25.5,
      "width": 142.9198760986328,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1626546200,
      "version": 3,
      "versionNonce": 403667224,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058121,
      "link": null,
      "locked": false,
      "text": "Design Pitfalls",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "zNGfWDnN9bzjrFSJdQS-6",
      "originalText": "Design Pitfalls",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kVP3Ttu4Xu8L4fpUmEXH-",
      "type": "text",
      "x": 17.730079650878906,
      "y": 198,
      "width": 240.5398406982422,
      "height": 200,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 449273112,
      "version": 3,
      "versionNonce": 1301431400,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058121,
      "link": null,
      "locked": false,
      "text": "Redundancy\nThe same fact is stored\nin more\nthan one place\nunnecessarily\n(e.g., storing a course's\ntitle with\nevery section offering)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "DtXgxD6Gmt185r9nNp3_p",
      "originalText": "Redundancy\nThe same fact is stored in more\nthan one place unnecessarily\n(e.g., storing a course's title with\nevery section offering)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dTseXL20C8jmkPnrB3Gv-",
      "type": "text",
      "x": 327.8800735473633,
      "y": 173,
      "width": 240.23985290527344,
      "height": 250,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1762392600,
      "version": 3,
      "versionNonce": 1055954456,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058121,
      "link": null,
      "locked": false,
      "text": "Incompleteness\nThe design makes it\ndifficult\nor impossible to\nrepresent\ncertain real-world facts\n(e.g., no way to record a\ncourse\nthat has never been\noffered)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "wbvrI7dHqAMpJRHWiC97I",
      "originalText": "Incompleteness\nThe design makes it difficult\nor impossible to represent\ncertain real-world facts\n(e.g., no way to record a course\nthat has never been offered)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8HLAFQH7yRnQim4gykmFg",
      "type": "text",
      "x": 24.53008270263672,
      "y": 580.5,
      "width": 226.93983459472656,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 515176216,
      "version": 3,
      "versionNonce": 1453160296,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058121,
      "link": null,
      "locked": false,
      "text": "Risk: copies can go out\nof sync\n→ data inconsistency",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FUQ9dtI8_HkDe4q1vVNF4",
      "originalText": "Risk: copies can go out of sync\n→ data inconsistency",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yY03WBTPjwLk9IpAJ1Ddf",
      "type": "text",
      "x": 328.05010986328125,
      "y": 555.5,
      "width": 239.8997802734375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 271995928,
      "version": 3,
      "versionNonce": 94769944,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058121,
      "link": null,
      "locked": false,
      "text": "Risk: work-arounds using\nnulls,\nwhich primary-key\nconstraints\nmay even forbid",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "crjkoARDNZjHsCK0Z7MjP",
      "originalText": "Risk: work-arounds using nulls,\nwhich primary-key constraints\nmay even forbid",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
