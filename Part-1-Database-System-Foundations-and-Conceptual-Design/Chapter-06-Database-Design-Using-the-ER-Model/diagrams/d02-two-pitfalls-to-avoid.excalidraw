      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697188,
      "link": null,
      "locked": false,
      "text": "Design Pitfalls",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t7M1ojW6iUBRKQWqfVLSk",
      "originalText": "Design Pitfalls",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q70vWnkJyZcyDfvhm8ji_",
      "type": "text",
      "x": 82.39013671875,
      "y": 204,
      "width": 328.2197265625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#7a1a1a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 998125756,
      "version": 3,
      "versionNonce": 1955488516,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697188,
      "link": null,
      "locked": false,
      "text": "Redundancy\nThe same fact is stored in more\nthan one place unnecessarily\n(e.g., storing a course's title with\nevery section offering)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "awx4WKfzqVX0CxT8inFOK",
      "originalText": "Redundancy\nThe same fact is stored in more\nthan one place unnecessarily\n(e.g., storing a course's title with\nevery section offering)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZI1fy1wR0kv1TXiPgLVn2",
      "type": "text",
      "x": 509.4400939941406,
      "y": 191,
      "width": 311.11981201171875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#7a4a00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 175159612,
      "version": 3,
      "versionNonce": 742407996,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697188,
      "link": null,
      "locked": false,
      "text": "Incompleteness\nThe design makes it difficult\nor impossible to represent\ncertain real-world facts\n(e.g., no way to record a course\nthat has never been offered)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "dUbXpvaomiRkZDwk-DcE8",
      "originalText": "Incompleteness\nThe design makes it difficult\nor impossible to represent\ncertain real-world facts\n(e.g., no way to record a course\nthat has never been offered)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2Myb1N7rpngzES4FpObEr",
      "type": "text",
      "x": 102.03012084960938,
      "y": 448,
      "width": 306.93975830078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1526608316,
      "version": 3,
      "versionNonce": 1716740740,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697188,
      "link": null,
      "locked": false,
      "text": "Risk: copies can go out of sync\n→ data inconsistency",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "AHd54URr03hlqfKtDOT91",
      "originalText": "Risk: copies can go out of sync\n→ data inconsistency",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BQH6mTAHJ2SQqK-IpZdfX",
      "type": "text",
      "x": 507.31011962890625,
      "y": 435,
      "width": 294.3797607421875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 474520124,
      "version": 3,
      "versionNonce": 1693251516,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697188,
      "link": null,
      "locked": false,
      "text": "Risk: work-arounds using nulls,\nwhich primary-key constraints\nmay even forbid",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "UsNVHSQaQbmCNFHNsb7tG",
      "originalText": "Risk: work-arounds using nulls,\nwhich primary-key constraints\nmay even forbid",
      "autoResize": true,
      "lineHeight": 1.25
    }
