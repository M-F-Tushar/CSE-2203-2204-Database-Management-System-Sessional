    {
      "id": "obS5wEk8QZw9HSn4_TudL",
      "type": "text",
      "x": 380.0400619506836,
      "y": 72,
      "width": 142.9198760986328,
      "height": 25,
      "angle": 0,
      "strokeColor": "#7a4a00",
