    {
      "id": "guH_EOTBeCvqkJ8VQwWaG",
      "type": "text",
      "x": 13.490104675292969,
      "y": 190.5,
      "width": 249.01979064941406,
      "height": 125,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 197572968,
      "version": 3,
      "versionNonce": 1353977112,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060040,
      "link": null,
      "locked": false,
      "text": "Strong Entity Set\n→ one schema, all simple\nattributes,\nprimary key = entity set's\nprimary key",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "nOggP0ZIt-NUAhvcTP645",
      "originalText": "Strong Entity Set\n→ one schema, all simple attributes,\nprimary key = entity set's primary key",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F-VuHObqgsPuTVlV1Ux4L",
      "type": "text",
      "x": 329.36006927490234,
      "y": 165.5,
      "width": 237.2798614501953,
      "height": 175,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 544951400,
      "version": 3,
      "versionNonce": 1311830120,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060040,
      "link": null,
      "locked": false,
      "text": "Entity Set with Complex\nAttributes\n→ composite attrs\nflattened into\ncomponents;\nmultivalued attrs →\nSEPARATE schema",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Wo_wDnxR8u8H9TZG09U1L",
      "originalText": "Entity Set with Complex Attributes\n→ composite attrs flattened into components;\nmultivalued attrs → SEPARATE schema",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fx8WhC9lZQrMb-wsMvhNK",
      "type": "text",
      "x": 647.192138671875,
      "y": 165.5,
      "width": 221.61572265625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1998946152,
      "version": 3,
      "versionNonce": 501393944,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060040,
      "link": null,
      "locked": false,
      "text": "Weak Entity Set\n→ schema = own\nattributes + owner's\nprimary key;\nPK = owner PK +\ndiscriminator;\nFK → owner entity set",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "jPg72SpcTzTGQU-Kb4jdW",
      "originalText": "Weak Entity Set\n→ schema = own attributes + owner's primary key;\nPK = owner PK + discriminator;\nFK → owner entity set",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8zi3Rc7AeaUqK0B-WDiI4",
      "type": "text",
      "x": 947.970100402832,
      "y": 178,
      "width": 240.05979919433594,
      "height": 150,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1135208,
      "version": 3,
      "versionNonce": 646357864,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060040,
      "link": null,
      "locked": false,
      "text": "Relationship Set\n→ schema = union of\nparticipating PKs\n+ descriptive attributes;\nFK → each participating\nentity set",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "tjjvqm2qXOOQAllc38h52",
      "originalText": "Relationship Set\n→ schema = union of participating PKs\n+ descriptive attributes;\nFK → each participating entity set",
      "autoResize": true,
      "lineHeight": 1.25
    }
