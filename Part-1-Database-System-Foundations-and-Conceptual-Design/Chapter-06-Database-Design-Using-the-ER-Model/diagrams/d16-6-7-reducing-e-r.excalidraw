      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966698868,
      "link": null,
      "locked": false,
      "text": "Relationship Set → schema =\nunion of participating PKs +\ndescriptive attributes; FK →\neach participating entity set",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "A19L0yaY8n4SnesDCYGNP",
      "originalText": "Relationship Set → schema =\nunion of participating PKs +\ndescriptive attributes; FK →\neach participating entity set",
