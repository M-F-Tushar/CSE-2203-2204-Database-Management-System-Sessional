      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966698868,
      "link": null,
      "locked": false,
      "text": "Strong Entity Set → one schema,\nall simple attributes, primary\nkey = entity set's primary key",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "qCRx5Vl1V__cjpHBLgrDa",
      "originalText": "Strong Entity Set → one schema,\nall simple attributes, primary\nkey = entity set's primary key",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8gQ0EDuVWBmy1eB8PNFAQ",
      "type": "text",
      "x": 506.22215270996094,
      "y": 191,
      "width": 309.5556945800781,
      "height": 125,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1189203588,
      "version": 3,
      "versionNonce": 163358852,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966698868,
      "link": null,
      "locked": false,
      "text": "Entity Set with Complex\nAttributes → composite attrs\nflattened into components;\nmultivalued attrs → SEPARATE\nschema",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bE_qhD0-aR8auw_kv4Msv",
      "originalText": "Entity Set with Complex\nAttributes → composite attrs\nflattened into components;\nmultivalued attrs → SEPARATE\nschema",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4G-hfFxpr2k7wQDfxnnFV",
      "type": "text",
      "x": 914.0121612548828,
      "y": 191,
      "width": 324.9756774902344,
      "height": 125,
      "angle": 0,
      "strokeColor": "#7a4a00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 36527620,
      "version": 3,
      "versionNonce": 2082673084,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966698868,
      "link": null,
      "locked": false,
      "text": "Weak Entity Set → schema = own\nattributes + owner's primary\nkey; PK = owner PK +\ndiscriminator; FK → owner entity\nset",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "AZQOPa6zUF27qx6bMbgPf",
      "originalText": "Weak Entity Set → schema = own\nattributes + owner's primary\nkey; PK = owner PK +\ndiscriminator; FK → owner entity\nset",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
