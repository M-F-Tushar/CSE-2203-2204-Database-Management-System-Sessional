      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966699346,
      "link": null,
      "locked": false,
      "text": "Total vs. Partial (Completeness)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "acjnkAWh1Ymfzh807EeTe",
      "originalText": "Total vs. Partial (Completeness)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0BLDWAVUXvt_1vqNjOUbo",
      "type": "text",
      "x": 917.0400848388672,
      "y": 216,
      "width": 319.9198303222656,
      "height": 75,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 411286972,
      "version": 3,
      "versionNonce": 469795772,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966699346,
      "link": null,
      "locked": false,
      "text": "Total: every higher-level entity\nMUST belong to some lower-level\nset",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "AIlgEfgAK95guJrL-lffk",
      "originalText": "Total: every higher-level entity\nMUST belong to some lower-level\nset",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DzWtDh0d2e_N5MyyniHMc",
      "type": "text",
      "x": 1335.4001159667969,
      "y": 216,
      "width": 323.19976806640625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#202124",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 691840572,
      "version": 3,
      "versionNonce": 84387332,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966699346,
      "link": null,
      "locked": false,
      "text": "Partial: some higher-level entities\nmay belong to NO lower-level set\n(the DEFAULT)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "7z9M8dQayDdiNfUKs7lHI",
      "originalText": "Partial: some higher-level entities\nmay belong to NO lower-level set\n(the DEFAULT)",
      "autoResize": true,
      "lineHeight": 1.25
