      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966699346,
      "link": null,
      "locked": false,
      "text": "Overlapping vs. Disjoint",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rio22rpRuKtiVgzwDd8A6",
      "originalText": "Overlapping vs. Disjoint",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GoxEA6phSXtSXF_ItXtrl",
      "type": "text",
      "x": 82.46011352539062,
      "y": 191,
      "width": 327.07977294921875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#0d3c61",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1662952508,
      "version": 3,
      "versionNonce": 1153865476,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966699346,
      "link": null,
      "locked": false,
      "text": "Overlapping: an entity MAY belong\nto more than one subclass\n(e.g., person can be BOTH\nstudent AND employee)\n→ TWO separate arrows",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "UpquvSoi_uxVmoWRoiQer",
      "originalText": "Overlapping: an entity MAY belong\nto more than one subclass\n(e.g., person can be BOTH\nstudent AND employee)\n→ TWO separate arrows",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q2oh6Ntxw6HoXFVPsRzHo",
      "type": "text",
      "x": 508.0001220703125,
      "y": 204,
      "width": 310.999755859375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1555479740,
      "version": 3,
      "versionNonce": 1104497468,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966699346,
      "link": null,
      "locked": false,
      "text": "Disjoint: an entity belongs to\nAT MOST ONE subclass\n(e.g., instructor XOR secretary)\n→ ONE single arrow",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ut6ue_c2vp0kWAmqV_9qB",
      "originalText": "Disjoint: an entity belongs to\nAT MOST ONE subclass\n(e.g., instructor XOR secretary)\n→ ONE single arrow",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "J2qz-g67tecgPEmf9Lpqv",
      "type": "text",
      "x": 876.4001007080078,
      "y": 72,
      "width": 315.1997985839844,
      "height": 25,
      "angle": 0,
      "strokeColor": "#7a4a00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
