      "index": "aA",
      "roundness": null,
      "seed": 2064253720,
      "version": 3,
      "versionNonce": 1278097688,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060763,
      "link": null,
      "locked": false,
      "text": "Overlapping vs. Disjoint",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rrooj_28_ss_he_vUTvXo",
      "originalText": "Overlapping vs. Disjoint",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ms_lKyC4kkX7TWyzlQIGM",
      "type": "text",
      "x": 18.602149963378906,
      "y": 213,
      "width": 238.7957000732422,
      "height": 200,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 906616856,
      "version": 3,
      "versionNonce": 2143257704,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060763,
      "link": null,
      "locked": false,
      "text": "Overlapping: an entity\nMAY belong\nto more than one\nsubclass\n(e.g., person can be\nBOTH\nstudent AND employee)\n→ TWO separate arrows",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "qlCnSM4alKqQqSxDW_i8G",
      "originalText": "Overlapping: an entity MAY belong\nto more than one subclass\n(e.g., person can be BOTH\nstudent AND employee)\n→ TWO separate arrows",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jY5Cxq67S0ULGgZ6143Xj",
      "type": "text",
      "x": 329.32006072998047,
      "y": 238,
      "width": 237.35987854003906,
      "height": 150,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 520494360,
      "version": 3,
      "versionNonce": 20403736,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060763,
      "link": null,
      "locked": false,
      "text": "Disjoint: an entity\nbelongs to\nAT MOST ONE subclass\n(e.g., instructor XOR\nsecretary)\n→ ONE single arrow",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "3ISM77-KPIWNnjeDCqrPX",
      "originalText": "Disjoint: an entity belongs to\nAT MOST ONE subclass\n(e.g., instructor XOR secretary)\n→ ONE single arrow",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fOU5mi5bMryJV8HhOhpyO",
      "type": "text",
      "x": 831.6300430297852,
      "y": 28,
      "width": 162.7399139404297,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 2004007448,
      "version": 3,
      "versionNonce": 1361229672,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060763,
      "link": null,
      "locked": false,
      "text": "Total vs. Partial\n(Completeness)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lqd0UeRJsuTDvyCQ5n5C7",
      "originalText": "Total vs. Partial (Completeness)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TwJNRaWBU0hraQ3i4q9N-",
      "type": "text",
      "x": 641.320068359375,
      "y": 263,
      "width": 233.35986328125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 843298584,
      "version": 3,
      "versionNonce": 1360319256,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060763,
      "link": null,
      "locked": false,
      "text": "Total: every higher-level\nentity\nMUST belong to some\nlower-level set",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "gxTFmKB-_TJWxkd7BfKml",
      "originalText": "Total: every higher-level entity\nMUST belong to some lower-level set",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SQ1v31lsamWMVfkylZ4md",
      "type": "text",
      "x": 947.7700805664062,
      "y": 250.5,
      "width": 240.4598388671875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1139610648,
      "version": 3,
      "versionNonce": 363301480,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622060763,
      "link": null,
      "locked": false,
      "text": "Partial: some higher-level\nentities\nmay belong to NO lower-\nlevel set\n(the DEFAULT)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Ns0sIRqRvYTTeH9RyWsYt",
      "originalText": "Partial: some higher-level entities\nmay belong to NO lower-level set\n(the DEFAULT)",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
