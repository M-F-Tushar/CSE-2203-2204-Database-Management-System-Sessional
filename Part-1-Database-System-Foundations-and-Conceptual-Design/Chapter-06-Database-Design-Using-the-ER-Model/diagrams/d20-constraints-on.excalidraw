    {
      "id": "YtSX6eO0hRhuso8lAECyo",
      "type": "text",
      "x": 178.99008178710938,
      "y": 40.5,
      "width": 228.01983642578125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
