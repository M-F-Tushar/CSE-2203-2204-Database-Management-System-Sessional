    },
    {
      "id": "s7hgWjRlGsMmf2l-nJ0xy",
      "type": "text",
      "x": 19.18006134033203,
      "y": 145.5,
      "width": 237.63987731933594,
      "height": 125,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1659597416,
      "version": 3,
      "versionNonce": 1638458392,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058905,
      "link": null,
      "locked": false,
      "text": "One-to-One (1:1)\nAn A relates to at most\none B,\nand a B relates to at\nmost one A",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "BcXSG2yBcRp3YF4ZvDDST",
      "originalText": "One-to-One (1:1)\nAn A relates to at most one B,\nand a B relates to at most one A",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3MUPI0N2otwo2onDg8riK",
      "type": "text",
      "x": 325.5000762939453,
      "y": 158,
      "width": 244.99984741210938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 77653352,
      "version": 3,
      "versionNonce": 349768040,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058905,
      "link": null,
      "locked": false,
      "text": "One-to-Many (1:N)\nAn A relates to many Bs,\nbut a B relates to at\nmost one A",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "2TQ0gpLuCLB3F1sj9xrRI",
      "originalText": "One-to-Many (1:N)\nAn A relates to many Bs,\nbut a B relates to at most one A",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eGv7S6Mzc6-DsvGvs0wH2",
      "type": "text",
      "x": 639.180061340332,
      "y": 145.5,
      "width": 237.63987731933594,
      "height": 125,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1429207144,
      "version": 3,
      "versionNonce": 136618264,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058905,
      "link": null,
      "locked": false,
      "text": "Many-to-One (N:1)\nAn A relates to at most\none B,\nbut a B relates to many\nAs",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "8SUSnLwlXHkvm6qlKO4p2",
      "originalText": "Many-to-One (N:1)\nAn A relates to at most one B,\nbut a B relates to many As",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p2D2IluPkoT89Eedaczoj",
      "type": "text",
      "x": 950.4800720214844,
      "y": 145.5,
      "width": 235.03985595703125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 140815208,
      "version": 3,
      "versionNonce": 1925422184,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622058905,
      "link": null,
      "locked": false,
      "text": "Many-to-Many (M:N)\nAn A can relate to many\nBs,\nand a B can relate to\nmany As",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ZSGRqYph7oOhQOzXtjOIn",
      "originalText": "Many-to-Many (M:N)\nAn A can relate to many Bs,\nand a B can relate to many As",
      "autoResize": true,
      "lineHeight": 1.25
    }
