    {
      "id": "N9yph61ohiTF5eouHhAUV",
      "type": "text",
      "x": 82.13009643554688,
      "y": 191,
      "width": 331.73980712890625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 729571588,
      "version": 3,
      "versionNonce": 1596761916,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697838,
      "link": null,
      "locked": false,
      "text": "One-to-One (1:1)\nAn A relates to at most one B,\nand a B relates to at most one A",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "zFQqlROgsBQVPQHPL01Ay",
      "originalText": "One-to-One (1:1)\nAn A relates to at most one B,\nand a B relates to at most one A",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4U9GApS9W0DWcx6VfV7pu",
      "type": "text",
      "x": 512.1400756835938,
      "y": 191,
      "width": 330.7198486328125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#0d3c61",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1255252100,
      "version": 3,
      "versionNonce": 1958836868,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697838,
      "link": null,
      "locked": false,
      "text": "One-to-Many (1:N)\nAn A relates to many Bs,\nbut a B relates to at most one A",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "vMYYVi1el8Hk9IBcMMuXP",
      "originalText": "One-to-Many (1:N)\nAn A relates to many Bs,\nbut a B relates to at most one A",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7M0n_2a0NIaA2yXFGNOvD",
      "type": "text",
      "x": 941.3700866699219,
      "y": 191,
      "width": 307.25982666015625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#7a4a00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1548939268,
      "version": 3,
      "versionNonce": 1309433788,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966697838,
      "link": null,
      "locked": false,
      "text": "Many-to-One (N:1)\nAn A relates to at most one B,\nbut a B relates to many As",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "f6BGxjPENYGe3hgtA7nEE",
      "originalText": "Many-to-One (N:1)\nAn A relates to at most one B,\nbut a B relates to many As",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
