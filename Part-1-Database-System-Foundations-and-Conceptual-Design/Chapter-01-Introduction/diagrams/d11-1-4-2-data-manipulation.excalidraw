      "boundElements": null,
      "updated": 1788622055739,
      "link": null,
      "locked": false,
      "text": "SQL is the classic\nexample.\nEasier to learn & use;\nthe query optimizer picks\nthe efficient access plan",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "eG5oR9QdJWa12KE1ERfW_",
      "originalText": "SQL is the classic example.\nEasier to learn & use;\nthe query optimizer picks\nthe efficient access plan",
