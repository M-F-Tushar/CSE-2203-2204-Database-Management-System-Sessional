      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622055739,
      "link": null,
      "locked": false,
      "text": "Procedural DML\nUser specifies WHAT\ndata\nis needed AND HOW to\nget it",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "xTbtEymH4qV1JhPWxupIZ",
      "originalText": "Procedural DML\nUser specifies WHAT data\nis needed AND HOW to get it",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cptbJcj8e8sPKjvBgWDhH",
      "type": "text",
      "x": 324.19010162353516,
      "y": 148,
      "width": 247.6197967529297,
      "height": 150,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 776537880,
      "version": 3,
      "versionNonce": 1871760408,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622055739,
      "link": null,
      "locked": false,
      "text": "Declarative / Non-\nprocedural DML\nUser specifies only WHAT\ndata\nis needed — system\ndecides HOW",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "UKhsqBn1dSH_eXgjOvG7n",
      "originalText": "Declarative / Non-procedural DML\nUser specifies only WHAT data\nis needed — system decides HOW",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
