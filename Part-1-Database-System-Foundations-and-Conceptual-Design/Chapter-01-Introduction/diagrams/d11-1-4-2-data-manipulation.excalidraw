      "link": null,
      "locked": false,
      "text": "Procedural DML\nUser specifies WHAT data\nis needed AND HOW to get it",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "LbcQYVW5lp6kfk3-1XEUe",
      "originalText": "Procedural DML\nUser specifies WHAT data\nis needed AND HOW to get it",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zTRaHln__J1_PGVbA_kKw",
      "type": "text",
      "x": 467.36012268066406,
