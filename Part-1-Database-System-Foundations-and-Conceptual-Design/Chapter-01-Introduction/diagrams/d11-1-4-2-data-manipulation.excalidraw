      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966693545,
      "link": null,
      "locked": false,
      "text": "Declarative / Non-procedural DML\nUser specifies only WHAT data\nis needed — system decides HOW",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "dzFplbbLdXJOOgxGDUQvw",
      "originalText": "Declarative / Non-procedural DML\nUser specifies only WHAT data\nis needed — system decides HOW",
      "autoResize": true,
      "lineHeight": 1.25
    },
