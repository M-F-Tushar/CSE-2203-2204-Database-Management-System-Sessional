      "boundElements": null,
      "updated": 1788622062991,
      "link": null,
      "locked": false,
      "text": "Natural Join\nauto-matches ALL same-\nnamed\nattributes across both\ntables",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "6hgRylmKN2fzDRxVDQGz3",
      "originalText": "Natural Join\nauto-matches ALL same-named\nattributes across both tables",
      "autoResize": true,
      "lineHeight": 1.25
    },
