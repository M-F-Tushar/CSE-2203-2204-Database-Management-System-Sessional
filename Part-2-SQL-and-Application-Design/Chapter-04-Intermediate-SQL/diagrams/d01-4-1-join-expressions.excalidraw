      "text": "Natural Join\nauto-matches ALL same-named\nattributes across both tables",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "959QyzWsjEVDxBwF-Uffv",
      "originalText": "Natural Join\nauto-matches ALL same-named\nattributes across both tables",
      "autoResize": true,
      "lineHeight": 1.25
    },
