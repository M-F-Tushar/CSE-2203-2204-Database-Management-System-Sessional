      "link": null,
      "locked": false,
      "text": "select * from instructor\nwhere name = 'X\\' or \\'Y\\' = \\'Y'\n\n✅ Treated as one literal string\n→ returns empty result",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "pvNt01eRf0g-SpYsXmXuY",
      "originalText": "select * from instructor\nwhere name = 'X\\' or \\'Y\\' = \\'Y'\n\n✅ Treated as one literal string\n→ returns empty result",
