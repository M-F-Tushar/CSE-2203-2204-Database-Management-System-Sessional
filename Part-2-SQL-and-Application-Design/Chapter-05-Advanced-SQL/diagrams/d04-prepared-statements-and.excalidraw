    {
      "id": "GyRiywGiLpNO1To6aNtlH",
      "type": "text",
      "x": 82.04963684082031,
      "y": 388,
      "width": 334.9007263183594,
      "height": 125,
      "angle": 0,
      "strokeColor": "#7a1a1a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
