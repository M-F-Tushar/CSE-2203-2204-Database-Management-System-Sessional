      "roundness": null,
      "seed": 1740559236,
      "version": 3,
      "versionNonce": 1856732932,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966703446,
      "link": null,
      "locked": false,
      "text": "select * from instructor\nwhere name = 'X' or 'Y' = 'Y'\n\n⚠️ WHERE clause is always TRUE\n→ entire table is leaked!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rp6TAAa7hZJAjCHldDrlS",
      "originalText": "select * from instructor\nwhere name = 'X' or 'Y' = 'Y'\n\n⚠️ WHERE clause is always TRUE\n→ entire table is leaked!",
      "autoResize": true,
      "lineHeight": 1.25
    },
