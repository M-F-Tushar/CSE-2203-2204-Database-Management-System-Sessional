      "text": "How is the\nquery built?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "zlvtWLYCj8F2rCH8u7gYQ",
      "originalText": "How is the query built?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "B_U0ckDYi6D6d4DsIy6_E",
      "type": "text",
      "x": 19.88214874267578,
      "y": 640.5,
      "width": 236.23570251464844,
      "height": 175,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 2061501288,
      "version": 3,
      "versionNonce": 604370024,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622065751,
      "link": null,
      "locked": false,
      "text": "select * from instructor\nwhere name = 'X' or 'Y' =\n'Y'\n\n⚠️ WHERE clause is\nalways TRUE\n→ entire table is leaked!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "7hfFcVwDdOgCL1DSwMGii",
      "originalText": "select * from instructor\nwhere name = 'X' or 'Y' = 'Y'\n\n⚠️ WHERE clause is always TRUE\n→ entire table is leaked!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "imt_QONKIGAPkESQ1ER54",
      "type": "text",
      "x": 323.35960388183594,
      "y": 640.5,
      "width": 249.28079223632812,
      "height": 175,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
