      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622065751,
      "link": null,
      "locked": false,
      "text": "select * from instructor\nwhere name = 'X\\' or \\'Y\\'\n= \\'Y'\n\n✅ Treated as one literal\nstring\n→ returns empty result",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "IFuB_UIoLRw8pWl8KNTrJ",
      "originalText": "select * from instructor\nwhere name = 'X\\' or \\'Y\\' = \\'Y'\n\n✅ Treated as one literal string\n→ returns empty result",
      "autoResize": true,
      "lineHeight": 1.25
    },
