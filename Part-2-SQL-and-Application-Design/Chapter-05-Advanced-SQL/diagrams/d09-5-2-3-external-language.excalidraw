    },
    {
      "id": "MI3YjZ9k5C4J_diHpthO5",
      "type": "text",
      "x": 30.890090942382812,
      "y": 220.5,
      "width": 214.21981811523438,
      "height": 125,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1155963416,
      "version": 3,
      "versionNonce": 1803820648,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622066362,
      "link": null,
      "locked": false,
      "text": "In-process execution\nFast, but a bug can\ncorrupt\ndatabase memory /\nbypass access control",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0evu6rnnybI_bD0o9wyu3",
      "originalText": "In-process execution\nFast, but a bug can corrupt\ndatabase memory / bypass access control",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EfHsQDbQ89iC9qvIStR7_",
      "type": "text",
      "x": 323.46009063720703,
      "y": 208,
      "width": 249.07981872558594,
      "height": 150,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1715181336,
      "version": 3,
      "versionNonce": 354507800,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622066362,
      "link": null,
      "locked": false,
      "text": "**Separate process +\ninterprocess\ncommunication**\nSafer, but much slower\n(tens of thousands of\ninstructions of overhead)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "O5-BAtqvo9H_9-9TLTHBI",
      "originalText": "**Separate process +\ninterprocess communication**\nSafer, but much slower\n(tens of thousands of instructions of overhead)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7h6hX7S12L2xlPZ3TSHDz",
      "type": "text",
      "x": 653.2500839233398,
      "y": 195.5,
      "width": 209.4998321533203,
      "height": 175,
      "angle": 0,
      "strokeColor": "#fff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1843983384,
      "version": 3,
      "versionNonce": 1296306536,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622066362,
      "link": null,
      "locked": false,
      "text": "Sandbox execution\n(Java/C# only)\nRuns inside the query\nprocess but\nrestricted to its own\nmemory —\nbest of both worlds",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ZTyTQ2xUSCcUzvtvj-EGs",
      "originalText": "Sandbox execution\n(Java/C# only)\nRuns inside the query process but\nrestricted to its own memory —\nbest of both worlds",
      "autoResize": true,
      "lineHeight": 1.25
    }
