      "roundness": null,
      "seed": 949494148,
      "version": 3,
      "versionNonce": 1120463804,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966702977,
      "link": null,
      "locked": false,
      "text": "1. Limited expressive power Some\ncomputations (loops, complex\ncontrol flow) cannot be written\nin SQL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "_qn6PNuc9w24K2H5JyAos",
      "originalText": "1. Limited expressive power Some\ncomputations (loops, complex\ncontrol flow) cannot be written\nin SQL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u09Nh2RozjedStkL0GkyG",
