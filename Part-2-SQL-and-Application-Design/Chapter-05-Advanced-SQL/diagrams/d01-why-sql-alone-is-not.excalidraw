      "isDeleted": false,
      "boundElements": null,
      "updated": 1788966702977,
      "link": null,
      "locked": false,
      "text": "2. Nondeclarative actions\nPrinting reports, GUIs, sending\nresults to a web page — SQL\ncannot do these",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
